    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1583.0",
    "axios": "^1.6.8",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.1",
    "swagger-jsdoc": "^6.2.8"
