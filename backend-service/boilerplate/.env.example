# Template for generated services (copied to <projectId>/ in S3 on project creation).
# Only NODE_ENV is read from .env (serverless.yml: useDotenv). The other variables the
# generated code uses are written into serverless.yml by Kanobi, not set here:
#   - AWS_DEPLOY_REGION: set by projectCreatedHandler
#   - <MODEL>STABLE<SUFFIX> (one per model table): set by modelCreated/UpdatedHandler.
#     codeBuilder rewrites the template's process.env.TABLE_NAME to this name and
#     process.env.FUNCTION_NAME to the handler name, so neither is a real env var.
NODE_ENV=production
